{
  "ads_version": "1.0",
  "project_name": "agent-dev-spec",
  "vision_one_liner": "为开发者和 Agent 提供一套可直接接入真实项目的 repo-native 协同规范与工具包。",
  "default_roles": [
    "Architect",
    "Frontend",
    "Backend",
    "Integration",
    "HumanOwner",
    "Reviewer",
    "AgentImplementer"
  ],
  "default_team_patterns": [
    "frontend-backend-integration",
    "human-agent-review"
  ],
  "constraints": [
    "保持 ADS 对外接入体验简单明确，根 README 是唯一入口",
    "新增行为必须优先支持已有项目安全接入，不直接破坏宿主仓库现有开发节奏",
    "所有产品级改动完成前都要通过 pytest、validate_ads 和 sync-tools 校验"
  ],
  "standard_verify_commands": {
    "test": "python3 -m pytest -q",
    "validate": "python3 scripts/validate_ads.py",
    "sync_tools": "python3 scripts/sync-tools.py --check"
  },
  "docs_entry": {
    "readme": "README.md",
    "ai_context": "docs/guides/adoption-playbook.md",
    "project_brief": "README.md",
    "start_here": ".ai/START_HERE.md"
  }
}
